[Unit]
Description=EcoFlutuador V4 local control and data API
After=local-fs.target
Conflicts=ecoflutuador.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=eco
WorkingDirectory=/home/eco/EcoFlutuador/poc_raspberry
ExecStart=/usr/bin/python3 /home/eco/EcoFlutuador/poc_raspberry/main.py production --allow-control --config /home/eco/EcoFlutuador/poc_raspberry/config.local.yaml
Restart=on-failure
RestartSec=10
TimeoutStopSec=5
KillSignal=SIGTERM
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
